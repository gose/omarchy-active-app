#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

jq empty manifest.json
omarchy plugin validate .

qmllint_bin=$(command -v qmllint || true)
if [[ -z $qmllint_bin && -x /usr/lib/qt6/bin/qmllint ]]; then
  qmllint_bin=/usr/lib/qt6/bin/qmllint
fi

if [[ -n $qmllint_bin ]]; then
  omarchy_path="${OMARCHY_PATH:-/usr/share/omarchy}"
  "$qmllint_bin" -I "$omarchy_path/shell" BarWidget.qml
else
  printf '%s\n' 'warning: qmllint is unavailable; QML lint skipped' >&2
fi

if find -P . -path ./.git -prune -o -type l -print -quit | grep -q .; then
  printf '%s\n' 'repository contains a symlink' >&2
  exit 1
fi

if rg -n '[[:blank:]]+$' -g '*.md' -g '*.qml' -g '*.json' -g '*.sh' .; then
  printf '%s\n' 'repository contains trailing whitespace' >&2
  exit 1
fi

git diff --check
printf '%s\n' 'All checks passed.'
